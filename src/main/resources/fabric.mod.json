{
  "schemaVersion": 1,
  "id": "batterydisplay",
  "icon": "assets/batterydisplay/icon.png",
  "authors": ["xy0acer"],
  "version": "${version}",
  "name": "Linux Battery Display",
  "description": "A small, Linux battery percentage display in the bottom-right corner of your HUD.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "lat.acer.batterydisplay.BatteryDisplayClient"
    ],
    "modmenu": [
      "lat.acer.batterydisplay.BatteryDisplayModMenu"
    ]
  },
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "fabric-api": ">=${fabricApiVersion}"
  }
}
